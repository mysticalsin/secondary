{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.secondary.invalid/prd/1.2/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "secondary.policy-decision/1"
    },
    "policy_decision_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "plane": {
      "$ref": "common.schema.json#/$defs/plane_hosted"
    },
    "account_id": {
      "$ref": "common.schema.json#/$defs/account_id"
    },
    "subspace_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "expected_previous_revision": {
      "$ref": "common.schema.json#/$defs/expected_previous_revision"
    },
    "classification": {
      "$ref": "common.schema.json#/$defs/business_classification"
    },
    "personal_data_state": {
      "$ref": "common.schema.json#/$defs/personal_data_state"
    },
    "owner_ref": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "source_lineage": {
      "$ref": "common.schema.json#/$defs/source_lineage"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle"
    },
    "retention": {
      "$ref": "common.schema.json#/$defs/retention"
    },
    "principal_ref": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "action": {
      "enum": [
        "read_metadata",
        "read_content",
        "search",
        "stage_draft",
        "commit",
        "review",
        "publish",
        "export",
        "grant_task",
        "resolve_identity"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "object_id"],
      "properties": {
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/opaque_id"
        },
        "object_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "purpose_code": {
      "$ref": "common.schema.json#/$defs/purpose_code"
    },
    "decision": {
      "enum": ["allow", "deny"]
    },
    "reason_code": {
      "$ref": "common.schema.json#/$defs/reason_code"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ],
      "description": "Lease end for allow (max 30 s, server enforced). null for deny."
    },
    "membership_refs": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/opaque_id"
      }
    }
  },
  "required": [
    "schema_version",
    "policy_decision_id",
    "tenant_id",
    "plane",
    "revision",
    "expected_previous_revision",
    "classification",
    "personal_data_state",
    "owner_ref",
    "source_lineage",
    "lifecycle",
    "retention",
    "principal_ref",
    "action",
    "resource",
    "purpose_code",
    "decision",
    "reason_code",
    "policy_epoch",
    "decided_at",
    "expires_at",
    "membership_refs"
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "plane": {
            "const": "ACCOUNT_RESTRICTED"
          }
        },
        "required": ["plane"]
      },
      "then": {
        "properties": {
          "account_id": {},
          "subspace_id": {}
        },
        "required": ["account_id", "subspace_id"]
      },
      "else": {
        "properties": {
          "account_id": {},
          "subspace_id": {}
        },
        "not": {
          "anyOf": [
            {
              "required": ["account_id"]
            },
            {
              "required": ["subspace_id"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "personal_data_state": {
            "const": "unknown_quarantined"
          }
        },
        "required": ["personal_data_state"]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "type": "object",
            "properties": {
              "state": {
                "const": "quarantined"
              }
            },
            "required": ["state"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "plane": {
            "const": "ACCOUNT_RESTRICTED"
          }
        },
        "required": ["plane"]
      },
      "then": {
        "properties": {
          "classification": {
            "$ref": "common.schema.json#/$defs/account_classification"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "plane": {
            "const": "GLOBAL_NONPERSONAL"
          }
        },
        "required": ["plane"]
      },
      "then": {
        "properties": {
          "classification": {
            "const": "global_reusable"
          },
          "personal_data_state": {
            "const": "none_identified"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "decision": {
            "const": "allow"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "expires_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "required": ["expires_at"]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "decision": {
            "const": "deny"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "expires_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
