{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "activity/validate.mjs",
    "import/policy.mjs",
    "ledger/object.mjs",
    "ledger/policy.mjs",
    "personal/plan.mjs",
    "release/identity.mjs",
    "release/jwks-validator.mjs",
    "release/routes.mjs",
    "ui/pages.mjs"
  ]
}
