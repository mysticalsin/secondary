{
  "name": "secondary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "dev": "pnpm --filter @secondary/web build && pnpm --filter @secondary/api dev",
    "dev:all": "node scripts/dev-all.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:mcp": "node e2e/mcp-client.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
