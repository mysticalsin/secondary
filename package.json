{
  "name": "secondary-api-recovery",
  "private": true,
  "type": "module",
  "description": "Private local preservation of recovered Secondary API source, with a typecheck and test harness. Not a deployable Worker.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --preserve-symlinks --experimental-strip-types --import ./reconstruction/register-test-hooks.mjs --test --test-reporter=spec harness/tests/*.test.ts harness/runtime/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:reconstructed": "tsc --noEmit -p reconstruction/tsconfig.json",
    "typecheck:workers": "node reconstruction/typecheck-workers.mjs",
    "build:worker": "esbuild reconstruction/worker-root/worker/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=reconstruction/dist/worker.js --preserve-symlinks --alias:@secondary/policy=./harness/adapters/policy-entry.ts --external:cloudflare:workers --banner:js=\"/* Local reconstruction bundle. Not a deployment artifact. */\"",
    "build:workers": "node reconstruction/build-workers.mjs",
    "build:workerd": "node reconstruction/workerd/bundle-workerd.mjs",
    "test:workerd": "node --preserve-symlinks --experimental-strip-types --test --test-reporter=spec reconstruction/workerd/runtime.test.mjs reconstruction/workerd/mcp-oauth.test.mjs reconstruction/workerd/import-isolation.test.mjs reconstruction/workerd/mcp-import-roundtrip.test.mjs reconstruction/workerd/release-auth.test.mjs reconstruction/workerd/integrity.test.mjs",
    "deploy": "node reconstruction/refuse-deploy.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openuidev/lang-core": "1.1.0",
    "agents": "^0.33.0",
    "ajv": "^8.20.0",
    "hono": "4.13.17",
    "jose": "6.2.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@types/node": "22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "wrangler": "^4.158.0"
  }
}
