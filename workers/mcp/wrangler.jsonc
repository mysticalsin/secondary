{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secondary-mcp-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: required for safe Client ID Metadata Document fetches (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // M1: workers.dev stays on because LLM hosts must reach the discovery documents, /register, /token and
  // /mcp without Access. /authorize must require a valid Access JWT: the Access app covers that path and
  // the worker verifies the JWT again (C1). Where Access is not configured /authorize answers 401,
  // except on a loopback host in dev. Preview URLs are off: separate hosts that no Access app covers.
  "workers_dev": true,
  "preview_urls": false,
  // Optional custom route. Not set in B1; the host is decided at deploy time. Placeholder:
  //   "routes": [{ "pattern": "secondary-mcp-dev.<your-domain>/*", "zone_name": "<your-domain>" }]
  // OAuth provider state (clients, grants, token hashes). KV is NOT EU-restricted: it holds only token
  // hashes, opaque ids and grant metadata, plus props encrypted with a key only the token holder can unwrap.
  // No Secondary content is ever stored here. Add "id" when the namespace is created at deploy time.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "007da72a703c4a73b1ba042c3a02e87f" }],
  "services": [
    { "binding": "API", "service": "secondary-api-dev" },
    { "binding": "AUDIT", "service": "secondary-audit-dev" }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    // Tenant stamped on MCP audit receipts. Same value as workers/api.
    "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
    // Canonical public origin, for example "https://secondary-mcp-dev.<account>.workers.dev". It is the token
    // audience (RFC 8707). Required outside dev; in dev an empty value falls back to the request origin.
    "MCP_PUBLIC_URL": "",
    // Cloudflare Access in front of /authorize. Empty until Access is configured: /authorize then answers 401, except dev test headers on a loopback host.
    "ACCESS_TEAM_DOMAIN": "tony-walteur.cloudflareaccess.com",
    "ACCESS_AUD": "feb4350db153fcca208d1e398e2f5660ab2abf50f3e1d366464addcda517dd89",
    // Redirect URIs allowed to receive authorization codes (B-05, L3): exact URLs, or a path prefix ending in *. Never a bare host.
    "ALLOWED_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,https://dust.tt/oauth/*,https://eu.dust.tt/oauth/*,http://localhost/*,http://127.0.0.1/*"
  },
  // Environments: each block is complete (wrangler does not inherit bindings or vars). Staging and prod
  // have their own KV namespace and no loopback redirect hosts. MCP_PUBLIC_URL must be pinned per
  // environment (it is the token audience); until it is set the worker answers 500 and nothing is served.
  "env": {
    "staging": {
      "name": "secondary-mcp-staging",
      "workers_dev": true,
      "preview_urls": false,
      // Own KV namespace. deploy.sh creates it and replaces the token below with its id.
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "__KV_OAUTH_STAGING__" }],
      "services": [
        { "binding": "API", "service": "secondary-api-staging" },
        { "binding": "AUDIT", "service": "secondary-audit-staging" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
        "MCP_PUBLIC_URL": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOWED_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,https://dust.tt/oauth/*,https://eu.dust.tt/oauth/*"
      }
    },
    "prod": {
      "name": "secondary-mcp-prod",
      // No workers.dev host in production. Placeholder route until the domain is chosen; a deploy fails on it on purpose.
      "workers_dev": false,
      "routes": [{ "pattern": "secondary-mcp.<your-domain>/*", "zone_name": "<your-domain>" }],
      "preview_urls": false,
      // Own KV namespace. deploy.sh creates it and replaces the token below with its id.
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "__KV_OAUTH_PROD__" }],
      "services": [
        { "binding": "API", "service": "secondary-api-prod" },
        { "binding": "AUDIT", "service": "secondary-audit-prod" }
      ],
      "vars": {
        "ENVIRONMENT": "prod",
        "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
        "MCP_PUBLIC_URL": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOWED_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,https://dust.tt/oauth/*,https://eu.dust.tt/oauth/*"
      }
    }
  }
  // Secrets (wrangler secret put ...): never in this file.
  //   INTERNAL_HMAC_KEY  shared with workers/api
  //   AUDIT_KEY_MCP      append-only key for workers/audit (32+ chars)
}
