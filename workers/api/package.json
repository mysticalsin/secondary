{
  "name": "@secondary/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-validator.mjs && wrangler dev",
    "build": "node scripts/gen-validator.mjs && wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "node scripts/gen-validator.mjs && wrangler types && tsc --noEmit -p .",
    "test": "node scripts/gen-validator.mjs && vitest run"
  },
  "dependencies": {
    "@secondary/policy": "workspace:*",
    "hono": "4.13.16",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@secondary/web": "workspace:*",
    "ajv": "8.20.0",
    "wrangler": "4.153.0"
  }
}
