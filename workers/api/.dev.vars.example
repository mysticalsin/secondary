# Copy to .dev.vars (gitignored) for `wrangler dev`. Never commit real values.
SEED_TOKEN=change-me-local-only
# Local-only sign-in without Cloudflare Access. Honoured only for localhost, 127.0.0.1 and [::1] in ENVIRONMENT=dev.
DEV_AUTH_BYPASS_EMAIL=dev@example.invalid
# workerd does not implement Durable Object jurisdictions locally. Deployed environments must keep "eu" (the default).
DO_JURISDICTION=off
# Shared with workers/mcp (at least 32 characters). Local-only value.
INTERNAL_HMAC_KEY=local-internal-hmac-key-0123456789abcdef
# The api alone (never workers/mcp): signs the proof of a generated brief (N-04). Local-only value.
# BRIEF_PROOF_KEY=local-brief-proof-key-0123456789abcdef
# Shared with workers/ops only (never workers/mcp). Needed only to run the ops worker locally.
# OPS_HMAC_KEY=local-ops-hmac-key-0123456789abcdef0123
# Optional: Entra ID sign-in and SCIM (see docs/runbooks/ENTRA-SETUP.md). Leave unset to keep Access only.
# AUTH_MODE=both
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=local-only-value
# SCIM_TOKEN=local-scim-token-at-least-32-characters
# AI processor (B2). Leave ANTHROPIC_API_KEY unset to keep the feature off. Real keys go through `wrangler secret put`.
# AI is off until all three are set: the key, AI_ENABLED=true and AI_PROCESSOR_CONTRACT=approved (a key alone never turns it on).
# AI_MODEL defaults to claude-sonnet-5-5.
# ANTHROPIC_API_KEY=
# AI_ENABLED=true
# AI_PROCESSOR_CONTRACT=approved
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_TOKEN_BUDGET=200000
