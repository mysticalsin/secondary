{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secondary-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // M1: the workers.dev host stays on, and the whole host sits behind one Cloudflare Access app (created
  // at deploy). The API also verifies the Access JWT itself and fails closed on every route except
  // /v1/health. Preview URLs are off: they are separate hosts that no Access app would cover.
  "workers_dev": true,
  "preview_urls": false,
  // Optional custom route. Not set in B1; the host is decided at deploy time. Placeholder:
  //   "routes": [{ "pattern": "secondary-dev.<your-domain>/*", "zone_name": "<your-domain>" }]
  // Static SPA built by apps/web (run `pnpm --filter @secondary/web build` first).
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the worker first so that security headers are set on static assets too.
    // The worker serves non-/v1 paths from the ASSETS binding.
    "run_worker_first": true
  },
  "durable_objects": {
    // Both namespaces are used through `namespace.jurisdiction("eu")` (see src/stubs.ts).
    "bindings": [
      { "name": "TENANT_POLICY", "class_name": "TenantPolicy" },
      { "name": "WORKSPACE", "class_name": "Workspace" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantPolicy", "Workspace"] }],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "secondary-blobs-dev", "jurisdiction": "eu" }
  ],
  "services": [
    { "binding": "AUDIT", "service": "secondary-audit-dev" },
    // Read-time permission check for source-backed items (fail closed). See workers/connector.
    { "binding": "CONNECTOR", "service": "secondary-connector-dev" }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    // Cloudflare Access team domain, e.g. "<team>.cloudflareaccess.com". Empty until Access is configured.
    "ACCESS_TEAM_DOMAIN": "tony-walteur.cloudflareaccess.com",
    // Cloudflare Access application AUD tag used to verify the JWT. Empty until Access is configured.
    "ACCESS_AUD": "0efbc36f4d84025cc095efdc94f9891dbf90a7d718f5c4e0c2837a7aae0a8974",
    // Tenant for emails whose domain is not in TENANT_DOMAINS.
    "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
    // JSON object mapping an email domain to a tenant id, e.g. {"example.invalid":"tenant_mantu_synthetic"}.
    "TENANT_DOMAINS": "{}",
    // Requests per principal per minute (Durable Object counter).
    "RATE_LIMIT_PER_MIN": "600",
    // Durable Objects are created in the EU jurisdiction. Local workerd cannot do that: .dev.vars sets "off".
    "DO_JURISDICTION": "eu",
    // Retention (days) for Personal Brain drafts and briefs. The ops cron deletes older ones.
    "RETENTION_DRAFT_DAYS": "90",
    "RETENTION_BRIEF_DAYS": "30",
    // Whether /v1/internal/ops/restore accepts a snapshot. "yes" in dev and staging, "no" in prod.
    "RESTORE_ENABLED": "yes"
  },
  // Environments. Wrangler does not inherit bindings or vars into an env, so each block is complete:
  // its own Durable Objects, EU buckets and audit worker. Dev-only features (personas, localhost
  // bypass, auto-seed) are keyed on ENVIRONMENT === "dev" in code, so they are off in both.
  // Deploy with scripts/deploy.sh <dev|staging|prod>.
  "env": {
    "staging": {
      "name": "secondary-api-staging",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../../apps/web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_POLICY", "class_name": "TenantPolicy" },
          { "name": "WORKSPACE", "class_name": "Workspace" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantPolicy", "Workspace"] }],
      "r2_buckets": [
        { "binding": "BLOBS", "bucket_name": "secondary-blobs-staging", "jurisdiction": "eu" }
      ],
      "services": [
        { "binding": "AUDIT", "service": "secondary-audit-staging" },
        { "binding": "CONNECTOR", "service": "secondary-connector-staging" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
        "TENANT_DOMAINS": "{}",
        "RATE_LIMIT_PER_MIN": "600",
        "DO_JURISDICTION": "eu",
        "RETENTION_DRAFT_DAYS": "90",
        "RETENTION_BRIEF_DAYS": "30",
        "RESTORE_ENABLED": "yes"
      }
    },
    "prod": {
      "name": "secondary-api-prod",
      // No workers.dev host in production: the custom domain below is the only entry point.
      // Placeholder until the domain is chosen. A deploy fails on it on purpose.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "secondary.<your-domain>/*", "zone_name": "<your-domain>" }],
      "assets": {
        "directory": "../../apps/web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_POLICY", "class_name": "TenantPolicy" },
          { "name": "WORKSPACE", "class_name": "Workspace" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantPolicy", "Workspace"] }],
      "r2_buckets": [
        { "binding": "BLOBS", "bucket_name": "secondary-blobs-prod", "jurisdiction": "eu" }
      ],
      "services": [
        { "binding": "AUDIT", "service": "secondary-audit-prod" },
        { "binding": "CONNECTOR", "service": "secondary-connector-prod" }
      ],
      "vars": {
        "ENVIRONMENT": "prod",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
        "TENANT_DOMAINS": "{}",
        "RATE_LIMIT_PER_MIN": "600",
        "DO_JURISDICTION": "eu",
        "RETENTION_DRAFT_DAYS": "90",
        "RETENTION_BRIEF_DAYS": "30",
        "RESTORE_ENABLED": "no"
      }
    }
  }
  // Secrets and local-only values, intentionally not set here (see .dev.vars.example):
  //   AUDIT_KEY_API          secret (32+ chars). Appends receipts to workers/audit.
  //   AUDIT_KEY_READ         secret (32+ chars). Reads receipts from workers/audit (Auditor views).
  //   CONNECTOR_HMAC_KEY     secret, at least 32 characters. Shared with workers/connector: signs calls in both directions.
  //   INTERNAL_HMAC_KEY      secret, at least 32 characters. Shared with workers/mcp: verifies its signed calls (X-Secondary-*).
  //   SEED_TOKEN             secret. Required by POST /v1/admin/seed (dev only).
  //   AUDIT_KEY_ERASE        secret (32+ chars). Lets the API pseudonymise receipts in workers/audit (right to erasure).
  //   PSEUDONYM_KEY          secret (32+ chars). Keys the pseudonyms; erasure is refused without it.
  //   ENTRA_CLIENT_SECRET    secret. Entra app client secret (B2 identity). Entra sign-in is off unless it and the two vars below are set.
  //   SCIM_TOKEN             secret, at least 32 characters. Bearer token for /scim/v2 (Entra provisioning). SCIM is off without it.
  // Optional vars, deliberately not listed in "vars" above (unset means off). Set per environment, see docs/runbooks/ENTRA-SETUP.md:
  //   AUTH_MODE              "access" (default) | "entra" | "both". Which identity sources are accepted.
  //   ENTRA_TENANT_ID        Entra directory (tenant) id, a GUID.
  //   ENTRA_CLIENT_ID        Entra application (client) id, a GUID.
  //   SCIM_TENANT_ID         tenant that owns the SCIM directory. Defaults to DEFAULT_TENANT_ID.
  //   ANTHROPIC_API_KEY      secret. Anthropic API key for the AI processor. Unset means the feature is off.
  //   AI_ENABLED / AI_MODEL / AI_DAILY_TOKEN_BUDGET / AI_TIMEOUT_MS  optional vars (kill switch "false", model id,
  //                          tokens per tenant per day, timeout). Defaults live in src/ai/config.ts.
  //   DEV_AUTH_BYPASS_EMAIL  local-dev var. Honoured only when ENVIRONMENT is "dev" AND the request host is
  //                          localhost, 127.0.0.1 or [::1]. Put it in .dev.vars, never in this file.
}
