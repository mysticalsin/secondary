{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secondary-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // M1: the workers.dev host stays on, and the whole host sits behind one Cloudflare Access app (created
  // at deploy). The API also verifies the Access JWT itself and fails closed on every route except
  // /v1/health. Preview URLs are off: they are separate hosts that no Access app would cover.
  "workers_dev": true,
  "preview_urls": false,
  // Optional custom route. Not set in B1; the host is decided at deploy time. Placeholder:
  //   "routes": [{ "pattern": "secondary-dev.<your-domain>/*", "zone_name": "<your-domain>" }]
  // Static SPA built by apps/web (run `pnpm --filter @secondary/web build` first).
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the worker first so that security headers are set on static assets too.
    // The worker serves non-/v1 paths from the ASSETS binding.
    "run_worker_first": true
  },
  "durable_objects": {
    // Both namespaces are used through `namespace.jurisdiction("eu")` (see src/stubs.ts).
    "bindings": [
      { "name": "TENANT_POLICY", "class_name": "TenantPolicy" },
      { "name": "WORKSPACE", "class_name": "Workspace" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantPolicy", "Workspace"] }],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "secondary-blobs-dev", "jurisdiction": "eu" }
  ],
  "services": [{ "binding": "AUDIT", "service": "secondary-audit-dev" }],
  "vars": {
    "ENVIRONMENT": "dev",
    // Cloudflare Access team domain, e.g. "<team>.cloudflareaccess.com". Empty until Access is configured.
    "ACCESS_TEAM_DOMAIN": "tony-walteur.cloudflareaccess.com",
    // Cloudflare Access application AUD tag used to verify the JWT. Empty until Access is configured.
    "ACCESS_AUD": "0efbc36f4d84025cc095efdc94f9891dbf90a7d718f5c4e0c2837a7aae0a8974",
    // Tenant for emails whose domain is not in TENANT_DOMAINS.
    "DEFAULT_TENANT_ID": "tenant_mantu_synthetic",
    // JSON object mapping an email domain to a tenant id, e.g. {"example.invalid":"tenant_mantu_synthetic"}.
    "TENANT_DOMAINS": "{}",
    // Requests per principal per minute (Durable Object counter).
    "RATE_LIMIT_PER_MIN": "600",
    // Durable Objects are created in the EU jurisdiction. Local workerd cannot do that: .dev.vars sets "off".
    "DO_JURISDICTION": "eu"
  }
  // Secrets and local-only values, intentionally not set here (see .dev.vars.example):
  //   AUDIT_KEY_API          secret (32+ chars). Appends receipts to workers/audit.
  //   AUDIT_KEY_READ         secret (32+ chars). Reads receipts from workers/audit (Auditor views).
  //   INTERNAL_HMAC_KEY      secret, at least 32 characters. Shared with workers/mcp: verifies its signed calls (X-Secondary-*).
  //   SEED_TOKEN             secret. Required by POST /v1/admin/seed (dev only).
  //   DEV_AUTH_BYPASS_EMAIL  local-dev var. Honoured only when ENVIRONMENT is "dev" AND the request host is
  //                          localhost, 127.0.0.1 or [::1]. Put it in .dev.vars, never in this file.
}
