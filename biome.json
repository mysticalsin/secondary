{
  "files": {
    "includes": [
      "**",
      "!**/out",
      "!**/sample",
      "!**/dist",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts",
      "!prototypes",
      "!.worktrees",
      "!.dev",
      "!**/.vitest",
      "!**/generated",
      "!docs",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "overrides": [
    {
      "includes": [
        "**/rules/seed.ts",
        "**/v7-rules.test.ts",
        "**/v7-rules-mock-contract.test.ts",
        "**/v7-rules-pulse.test.ts",
        "**/rules.test.ts",
        "**/v7-rules.e2e.ts",
        "**/v7-real.spec.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}
