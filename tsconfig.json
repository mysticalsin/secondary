{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "@secondary/policy": ["./harness/adapters/policy-entry.ts"]
    }
  },
  "include": [
    "src/state/**/*.ts",
    "recovered-source/shared/packages/**/*.ts",
    "harness/adapters/**/*.ts",
    "harness/tests/**/*.ts",
    "src/worker/admin/store.ts",
    "src/worker/admin/validate.ts",
    "src/worker/agent/stream.ts",
    "src/worker/ai/anthropic.ts",
    "src/worker/ai/config.ts",
    "src/worker/ai/proof.ts",
    "src/worker/ai/segments.ts",
    "src/worker/auth/identity-store.ts",
    "src/worker/auth/limits.ts",
    "src/worker/brains/importers.ts",
    "src/worker/brains/model.ts",
    "src/worker/brains/sanitize.ts",
    "src/worker/brains/unzip.ts",
    "src/worker/internal-auth.ts",
    "src/worker/ops-snapshot.ts",
    "src/worker/personal-kind.ts",
    "src/worker/scim/parse.ts",
    "src/worker/scope.ts",
    "src/worker/security-journal.ts",
    "src/worker/sensitivity.ts",
    "src/worker/switches.ts",
    "src/worker/uxv2/zip.ts",
    "src/worker/wiki/changes.ts",
    "src/worker/wiki/text.ts",
    "src/worker/wiki/types.ts"
  ]
}
